# =============================================================================
# Bio MCP Research Agent Environment Configuration
# Copy this file to .env and fill in your actual credentials.
# =============================================================================

# OpenRouter Configuration (Recommended for Qwen access)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=z-ai/glm-4.5-air:free

# Alternative: Local Ollama Configuration (Uncomment to use instead of OpenRouter)
# OPENAI_API_BASE=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# OPENROUTER_MODEL=glm-4.5-air

# Logging Configuration (Optional)
# LOG_LEVEL=INFO
# LOG_FILE=research_agent.log

# Research Configuration
# MAX_ITERATIONS=5
# TIMEOUT_SECONDS=300